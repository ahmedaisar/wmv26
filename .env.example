NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Supabase connection. Never use NEXT_PUBLIC_ for a key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Temporary compatibility fallback for projects still using the legacy key name.
# Keep this value server-only and remove it after SUPABASE_SECRET_KEY is configured.
SUPABASE_SERVICE_ROLE_KEY=
